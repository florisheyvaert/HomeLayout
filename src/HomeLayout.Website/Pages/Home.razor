@page "/"

<PageTitle>Home</PageTitle>

<canvas id="home">
</canvas>

<div class="position-absolute start-0 end-0 bottom-0" style="height: 5rem; background-color: white;">
    <div class="d-flex justify-content-center align-items-center w-100 h-100 p-2">

        <div class="p-2">
            <button class="p-2" @onclick="async() => await AddDrawing(Common.Static.DrawingStyles.InnerWall)">Add Inner Wall</button>
        </div>

        <div class="p-2">
            <button class="p-2" @onclick="async() => await AddDrawing(Common.Static.DrawingStyles.OuterWall)">Add Outer Wall</button>
        </div>

        <div class="p-2">
            <button class="p-2" @onclick="async() => await Save()">Save</button>
        </div>

    </div>
</div>