@inherits CoverBase

<div class="rounded-2 position-relative w-50" style="background: var(--entity-cover-bg-color); border: 1px solid var(--entity-cover-color-100)">

    <div class="d-flex align-items-center p-2">

        <div class="rounded-1 px-1 me-1 h-100" style="background-color: var(--entity-cover-color-700); color: var(--entity-cover-font-color);">
            <Icon Name="blinds" Size=".8rem" />
        </div>

        <h6 class="fw-bold w-100">Bureau</h6>
    </div>

    <div class="d-flex justify-content-between rounded-bottom" style="background: var(--entity-cover-color-700); color: var(--entity-cover-font-color)">
        <Icon Name="chevron-up" Size="1rem" />
        <Icon Name="chevron-down" Size="1rem" />
    </div>

    @*<div class="btn-group w-100">
        <a href="#" class="btn btn-entity-cover active" style="font-size: .75rem" aria-current="page">A</a>
    </div>*@
</div>